            continue
        }

        if ($choice -eq "10") {
            if (Confirm-Pika "Upgrade available applications?") {
                winget upgrade --all
            }

            Pause-Pika
            continue
        }

        $id = 0

        if ([int]::TryParse($choice, [ref]$id)) {
            $app = $apps |
                Where-Object { $_.Id -eq $id }

            if ($null -ne $app) {

                Write-Pika ""
                Write-Pika "Installing $($app.Name)..." Yellow

                winget install `
                    --id $app.Package `
                    --exact `
                    --accept-package-agreements `
                    --accept-source-agreements

                Write-Pika ""
                Write-Pika "Installation command completed." Green

                Pause-Pika
            }
        }
    }
}

