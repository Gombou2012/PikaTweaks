    if (Confirm-Pika "Restart Windows now?") {
        Restart-Computer
    }

    Pause-Pika
}

# ============================================================
# UPDATE CHECK
# ============================================================

function Update-PikaTweaks {

    Show-Header

    Write-Pika "PIKATWEAKS UPDATE" Cyan
    Write-Line

    Write-Pika "Current version: $script:PikaVersion"
    Write-Pika "Checking GitHub..." Yellow

    try {
        $remote = Invoke-WebRequest `
            -Uri $script:RawUrl `
            -UseBasicParsing `
            -TimeoutSec 10

        if ($remote.StatusCode -eq 200) {
            Write-Pika ""
            Write-Pika "GitHub version is available." Green
            Write-Pika "Review the remote script before executing it." Yellow

            if (Confirm-Pika "Download latest PikaTweaks.ps1?") {

                $destination = Join-Path `
                    $env:USERPROFILE `
                    "Downloads\PikaTweaks.ps1"

                $remote.Content |
                    Set-Content `
                        -Path $destination `
                        -Encoding UTF8

                Write-Pika ""
                Write-Pika "Downloaded to:" Green
                Write-Pika $destination White
            }
        }
    }
    catch {
        Write-Pika "Could not check GitHub." Red
    }

    Pause-Pika
}

