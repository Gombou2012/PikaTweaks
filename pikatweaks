function Invoke-OneClickOptimize {
    Show-PikaHeader

    Write-Host "ONE-CLICK OPTIMIZATION" -ForegroundColor Magenta
    Write-Host "------------------------------------------------------------"
    Write-Host ""
    Write-Host "PikaTweaks will:"
    Write-Host ""
    Write-Host "  * Create a configuration backup"
    Write-Host "  * Attempt a Windows restore point"
    Write-Host "  * Enable Game Mode"
    Write-Host "  * Disable background Game DVR capture"
    Write-Host "  * Select High Performance power plan"
    Write-Host "  * Flush DNS"
    Write-Host "  * Clean temporary files"
    Write-Host ""
    Write-Host "No overclocking or firmware changes will be performed."
    Write-Host ""

    if (-not (Confirm-Pika "Start One-Click Optimization?")) {
        return
    }

    Backup-PikaSettings

    try {
        Enable-ComputerRestore `
            -Drive "$env:SystemDrive\" `
            -ErrorAction SilentlyContinue

        Checkpoint-Computer `
            -Description "PikaTweaks One-Click" `
            -RestorePointType "MODIFY_SETTINGS" `
            -ErrorAction SilentlyContinue
    }
    catch {}

    New-Item `
        "HKCU:\Software\Microsoft\GameBar" `
        -Force | Out-Null

    Set-ItemProperty `
        "HKCU:\Software\Microsoft\GameBar" `
        -Name "AutoGameModeEnabled" `
        -Type DWord `
        -Value 1 `
        -Force

    New-Item `
        "HKCU:\Software\Microsoft\Windows\CurrentVersion\GameDVR" `
        -Force | Out-Null

    Set-ItemProperty `
        "HKCU:\Software\Microsoft\Windows\CurrentVersion\GameDVR" `
        -Name "AppCaptureEnabled" `
        -Type DWord `
        -Value 0 `
        -Force

    powercfg /setactive SCHEME_MAX

    ipconfig /flushdns | Out-Null

    Remove-Item "$env:TEMP\*" `
        -Recurse `
        -Force `
        -ErrorAction SilentlyContinue

    Write-PikaLog "One-click optimization completed."

    Write-Host ""
    Write-Host "============================================================" -ForegroundColor Green
    Write-Host "                 OPTIMIZATION COMPLETE" -ForegroundColor Green
    Write-Host "============================================================" -ForegroundColor Green
    Write-Host ""
    Write-Host "Restart Windows for the best result." -ForegroundColor Yellow

    Pause-Pika
}

