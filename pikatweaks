# ============================================================
# SYSTEM INFORMATION
# ============================================================

function Show-SystemInformation {
    Show-Header

    Write-Pika "SYSTEM INFORMATION" Cyan
    Write-Line

    try {
        $computer = Get-CimInstance Win32_ComputerSystem
        $os = Get-CimInstance Win32_OperatingSystem
        $cpu = Get-CimInstance Win32_Processor |
            Select-Object -First 1

        Write-Pika ("Computer       : {0}" -f $env:COMPUTERNAME)
        Write-Pika ("Windows        : {0}" -f $os.Caption)
        Write-Pika ("Build          : {0}" -f $os.BuildNumber)
        Write-Pika ("CPU            : {0}" -f $cpu.Name)
        Write-Pika ("RAM            : {0:N1} GB" -f
            ($computer.TotalPhysicalMemory / 1GB))
        Write-Pika ("Architecture   : {0}" -f $os.OSArchitecture)

        try {
            $gpu = Get-CimInstance Win32_VideoController |
                Where-Object { $_.Name -notlike "*Microsoft Basic*" }

            foreach ($card in $gpu) {
                Write-Pika ("GPU            : {0}" -f $card.Name)
            }
        }
        catch {}

        Write-Pika ""
        Write-Pika "Power Plan:" Cyan

        powercfg /getactivescheme

        Write-Pika ""
        Write-Pika "PikaTweaks root:"
        Write-Pika $script:PikaRoot DarkGray
    }
    catch {
        Write-Pika "Could not read complete system information." Yellow
    }

    Pause-Pika
}

