function Tweak-GameMode {
    Write-Pika "Enabling Game Mode..." Yellow

    Set-PikaRegistryValue `
        "HKCU:\Software\Microsoft\GameBar" `
        "AutoGameModeEnabled" `
        1

    Write-Pika "Game Mode enabled." Green
}

function Tweak-DisableGameDVR {
    Write-Pika "Disabling Game DVR capture..." Yellow

    Set-PikaRegistryValue `
        "HKCU:\Software\Microsoft\Windows\CurrentVersion\GameDVR" `
        "AppCaptureEnabled" `
        0

    Set-PikaRegistryValue `
        "HKCU:\System\GameConfigStore" `
        "GameDVR_Enabled" `
        0

    Write-Pika "Game DVR capture disabled." Green
}

function Tweak-EnableHAGS {
    Write-Pika "Enabling Hardware Accelerated GPU Scheduling..." Yellow

    Set-PikaRegistryValue `
        "HKLM:\SYSTEM\CurrentControlSet\Control\GraphicsDrivers" `
        "HwSchMode" `
        2

    Write-Pika "HAGS enabled where supported." Green
    Write-Pika "A restart may be required." Yellow
}

function Tweak-DisableHAGS {
    Write-Pika "Disabling Hardware Accelerated GPU Scheduling..." Yellow

    Set-PikaRegistryValue `
        "HKLM:\SYSTEM\CurrentControlSet\Control\GraphicsDrivers" `
        "HwSchMode" `
        1

    Write-Pika "HAGS disabled." Green
}

function Tweak-VisualEffects {
    Write-Pika "Reducing Windows visual effects..." Yellow

    Set-PikaRegistryValue `
        "HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\VisualEffects" `
        "VisualFXSetting" `
        2

    Write-Pika "Visual effects profile changed." Green
}

function Tweak-ExplorerExtensions {
    Write-Pika "Applying Explorer responsiveness settings..." Yellow

    Set-PikaRegistryValue `
        "HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced" `
        "ShowTaskViewButton" `
        1

    Set-PikaRegistryValue `
        "HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced" `
        "LaunchTo" `
        1

    Write-Pika "Explorer settings applied." Green
}

function Tweak-DisableSuggestions {
    Write-Pika "Disabling Windows content suggestions..." Yellow

    $path =
        "HKCU:\Software\Microsoft\Windows\CurrentVersion\ContentDeliveryManager"

    $values = @(
        "SystemPaneSuggestionsEnabled",
        "SubscribedContent-338388Enabled",
        "SubscribedContent-338389Enabled",
        "SilentInstalledAppsEnabled"
    )

    foreach ($name in $values) {
        Set-PikaRegistryValue $path $name 0
    }

    Write-Pika "Suggestions reduced." Green
}

function Tweak-HighPerformance {
    if (-not (Require-Admin)) {
        return
    }

    Write-Pika "Selecting High Performance power plan..." Yellow

    & powercfg.exe /setactive SCHEME_MAX 2>$null

    Write-Pika "High Performance selected." Green
}

function Tweak-UltimatePerformance {
    if (-not (Require-Admin)) {
        return
    }

    Write-Pika "Preparing Ultimate Performance..." Yellow

    $output = & powercfg.exe `
        -duplicatescheme `
        e9a42b02-d5df-448d-aa00-03f14749eb61 2>&1

    if ($LASTEXITCODE -eq 0) {
        Write-Pika "Ultimate Performance plan created." Green
    }
    else {
        Write-Pika "Ultimate Performance may already exist." Yellow
    }
}

function Tweak-CleanTemp {
    Write-Pika "Cleaning temporary files..." Yellow

    $paths = @(
        $env:TEMP,
        "$env:WINDIR\Temp"
    )

    foreach ($path in $paths) {
        if (Test-Path $path) {
            Get-ChildItem `
                -Path $path `
                -Force `
                -Recurse `
                -ErrorAction SilentlyContinue |
                Remove-Item `
                    -Force `
                    -Recurse `
                    -ErrorAction SilentlyContinue
        }
    }

    Write-Pika "Temporary files cleaned." Green
}

function Tweak-CleanRecycleBin {
    Write-Pika "Emptying Recycle Bin..." Yellow

    try {
        Clear-RecycleBin -Force -ErrorAction SilentlyContinue
        Write-Pika "Recycle Bin emptied." Green
    }
    catch {
        Write-Pika "Recycle Bin cleanup skipped." Yellow
    }
}

function Tweak-FlushDNS {
    Write-Pika "Flushing DNS cache..." Yellow

    & ipconfig.exe /flushdns | Out-Null

    Write-Pika "DNS cache flushed." Green
}

function Tweak-NetworkReset {
    if (-not (Require-Admin)) {
        return
    }

    Write-Pika "This resets Windows networking components." Yellow
    Write-Pika "You may need to restart Windows." Yellow

    if (-not (Confirm-Pika "Continue?")) {
        return
    }

    & netsh.exe winsock reset | Out-Null
    & netsh.exe int ip reset | Out-Null

    Write-Pika "Network reset commands completed." Green
}

function Tweak-Privacy {
    Write-Pika "Applying basic privacy settings..." Yellow

    Set-PikaRegistryValue `
        "HKCU:\Software\Microsoft\Windows\CurrentVersion\AdvertisingInfo" `
        "Enabled" `
        0

    Set-PikaRegistryValue `
        "HKCU:\Software\Microsoft\Windows\CurrentVersion\Privacy" `
        "TailoredExperiencesWithDiagnosticDataEnabled" `
        0

    Write-Pika "Basic privacy settings applied." Green
}

