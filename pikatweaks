# ============================================================
# TWEAK MENU
# ============================================================

function Show-TweakList {
    param(
        [string]$Category
    )

    $items = @(
        $script:Tweaks |
        Where-Object { $_.Category -eq $Category }
    )

    if ($items.Count -eq 0) {
        Write-Pika "No tweaks available." Yellow
        Pause-Pika
        return
    }

    while ($true) {
        Show-Header

        Write-Pika "$Category TWEAKS" Cyan
        Write-Line

        foreach ($item in $items) {
            Write-Pika ("[{0}] {1}" -f $item.Id, $item.Name) White
            Write-Pika ("    {0}" -f $item.Description) DarkGray
        }

        Write-Host ""
        Write-Pika "[A] Apply all $Category tweaks" Green
        Write-Pika "[0] Back"

        $choice = Read-Host "Select"

        if ($choice -eq "0") {
            return
        }

        if ($choice -match "^[Aa]$") {
            if ($Category -notin @("Cleanup","Network")) {
                New-PikaBackup | Out-Null
            }

            foreach ($item in $items) {
                Write-Pika ""
                Write-Pika ">>> $($item.Name)" Cyan

                try {
                    & $item.Action
                }
                catch {
                    Write-Pika "Skipped because an error occurred." Yellow
                }
            }

            Pause-Pika
            continue
        }

        $selectedId = 0

        if ([int]::TryParse($choice, [ref]$selectedId)) {
            $selected = $items |
                Where-Object { $_.Id -eq $selectedId }

            if ($null -ne $selected) {

                if ($Category -notin @("Cleanup","Network")) {
                    New-PikaBackup | Out-Null
                }

                Write-Pika ""
                Write-Pika ">>> $($selected.Name)" Cyan

                try {
                    & $selected.Action
                }
                catch {
                    Write-Pika "The tweak could not be applied." Red
                    Write-Log "Tweak failed: $($selected.Name)"
                }

                Pause-Pika
            }
        }
    }
}

