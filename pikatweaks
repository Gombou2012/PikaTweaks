# ============================================================
# UI
# ============================================================

function Write-Pika {
    param(
        [string]$Text,
        [ConsoleColor]$Color = [ConsoleColor]::Gray
    )

    Write-Host $Text -ForegroundColor $Color
}

function Write-Line {
    Write-Host ("-" * 72) -ForegroundColor DarkGray
}

function Pause-Pika {
    Write-Host ""
    Write-Host "Press ENTER to continue..." -ForegroundColor DarkGray
    [void](Read-Host)
}

function Show-Header {
    Clear-Host

    Write-Host ""
    Write-Host "  ██████╗ ██╗██╗  ██╗ █████╗ " -ForegroundColor Cyan
    Write-Host "  ██╔══██╗██║██║ ██╔╝██╔══██╗" -ForegroundColor Cyan
    Write-Host "  ██████╔╝██║█████╔╝ ███████║" -ForegroundColor Blue
    Write-Host "  ██╔═══╝ ██║██╔═██╗ ██╔══██║" -ForegroundColor Magenta
    Write-Host "  ██║     ██║██║  ██╗██║  ██║" -ForegroundColor Magenta
    Write-Host "  ╚═╝     ╚═╝╚═╝  ╚═╝╚═╝  ╚═╝" -ForegroundColor Cyan

    Write-Host ""
    Write-Host "              PIKATWEAKS v$script:PikaVersion" `
        -ForegroundColor White
    Write-Host "          Windows Optimization Utility" `
        -ForegroundColor DarkGray

    Write-Line
}

function Write-Log {
    param([string]$Message)

    $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"

    try {
        Add-Content -Path $script:LogFile `
            -Value "[$timestamp] $Message"
    }
    catch {}
}

function Confirm-Pika {
    param(
        [string]$Message
    )

    $answer = Read-Host "$Message [Y/N]"

    return ($answer -match "^(Y|YES)$")
}

# ============================================================
# ADMIN
# ============================================================

function Test-PikaAdmin {
    try {
        $identity =
            [Security.Principal.WindowsIdentity]::GetCurrent()

        $principal =
            New-Object Security.Principal.WindowsPrincipal($identity)

        return $principal.IsInRole(
            [Security.Principal.WindowsBuiltInRole]::Administrator
        )
    }
    catch {
        return $false
    }
}

function Require-Admin {
    if (Test-PikaAdmin) {
        return $true
    }

    Write-Pika ""
    Write-Pika "Administrator permission is required for this operation." Yellow

    if (-not (Confirm-Pika "Restart PikaTweaks as Administrator?")) {
        return $false
    }

    # When running through IEX, PSCommandPath can be unavailable.
    $scriptPath = $PSCommandPath

    if ([string]::IsNullOrWhiteSpace($scriptPath)) {
        $scriptPath = Join-Path $env:TEMP "PikaTweaks-Elevated.ps1"

        try {
            Invoke-WebRequest `
                -Uri $script:RawUrl `
                -OutFile $scriptPath `
                -UseBasicParsing
        }
        catch {
            Write-Pika "Could not download PikaTweaks for elevation." Red
            return $false
        }
    }

    try {
        Start-Process powershell.exe `
            -Verb RunAs `
            -ArgumentList "-NoProfile -ExecutionPolicy Bypass -File `"$scriptPath`""

        exit
    }
    catch {
        Write-Pika "Elevation failed." Red
        return $false
    }
}

# ============================================================
# BACKUP / RESTORE
# ============================================================

function New-PikaBackup {
    $stamp = Get-Date -Format "yyyyMMdd-HHmmss"

    $folder = Join-Path `
        $script:BackupRoot `
        "Backup-$stamp"

    New-Item -ItemType Directory -Force -Path $folder | Out-Null

    Write-Pika "Creating backup..." Yellow

    $keys = @(
        @{
            Name = "GameBar"
            Path = "HKCU\Software\Microsoft\GameBar"
        },
        @{
            Name = "GameDVR"
            Path = "HKCU\Software\Microsoft\Windows\CurrentVersion\GameDVR"
        },
        @{
            Name = "Explorer"
            Path = "HKCU\Software\Microsoft\Windows\CurrentVersion\Explorer"
        },
        @{
            Name = "ContentDelivery"
            Path = "HKCU\Software\Microsoft\Windows\CurrentVersion\ContentDeliveryManager"
        }
    )

    foreach ($key in $keys) {
        $file = Join-Path $folder "$($key.Name).reg"

        & reg.exe export $key.Path $file /y 2>$null | Out-Null
    }

    $info = @"
PikaTweaks Backup
Version: $script:PikaVersion
Created: $(Get-Date)
Computer: $env:COMPUTERNAME
User: $env:USERNAME
"@

    $info | Set-Content (Join-Path $folder "BackupInfo.txt")

    Write-Log "Created backup: $folder"

    Write-Pika ""
    Write-Pika "Backup created:" Green
    Write-Pika $folder White

    return $folder
}

function New-PikaRestorePoint {
    if (-not (Require-Admin)) {
        return
    }

    Write-Pika "Creating Windows restore point..." Yellow

    try {
        Checkpoint-Computer `
            -Description "PikaTweaks Backup" `
            -RestorePointType "MODIFY_SETTINGS"

        Write-Pika "Restore point created." Green
        Write-Log "Created restore point."
    }
    catch {
        Write-Pika "Windows could not create a restore point." Yellow
    }
}

function Get-PikaBackups {
    if (-not (Test-Path $script:BackupRoot)) {
        return @()
    }

    return @(Get-ChildItem `
        -Path $script:BackupRoot `
        -Directory |
        Sort-Object LastWriteTime -Descending)
}

function Restore-PikaBackup {
    $backups = Get-PikaBackups

    if ($backups.Count -eq 0) {
        Write-Pika "No PikaTweaks backups found." Yellow
        Pause-Pika
        return
    }

    Write-Pika ""
    Write-Pika "AVAILABLE BACKUPS" Cyan
    Write-Line

    for ($i = 0; $i -lt $backups.Count; $i++) {
        Write-Pika "[$($i + 1)] $($backups[$i].Name)"
    }

    Write-Pika "[0] Cancel"

    $choice = Read-Host "Select backup"

    if ($choice -eq "0") {
        return
    }

    $index = 0

    if (-not [int]::TryParse($choice, [ref]$index)) {
        return
    }

    if ($index -lt 1 -or $index -gt $backups.Count) {
        return
    }

    $selected = $backups[$index - 1]

    Write-Pika ""
    Write-Pika "Selected: $($selected.Name)" Yellow

    if (-not (Confirm-Pika "Restore this backup?")) {
        return
    }

    if (-not (Require-Admin)) {
        return
    }

    $files = Get-ChildItem $selected.FullName -Filter "*.reg"

    foreach ($file in $files) {
        Write-Pika "Restoring $($file.Name)..." Yellow

        & reg.exe import $file.FullName 2>$null | Out-Null
    }

    Write-Log "Restored backup: $($selected.FullName)"

    Write-Pika ""
    Write-Pika "Restore completed." Green

    Pause-Pika
}

function Backup-Restore-Menu {
    while ($true) {
        Show-Header

        Write-Pika "BACKUP / RESTORE" Cyan
        Write-Line

        Write-Pika "[1] Create registry backup"
        Write-Pika "[2] Create Windows restore point"
        Write-Pika "[3] Restore PikaTweaks backup"
        Write-Pika "[4] Open backup folder"
        Write-Pika "[0] Back"

        $choice = Read-Host "Select"

        switch ($choice) {
            "1" {
                New-PikaBackup | Out-Null
                Pause-Pika
            }

            "2" {
                New-PikaRestorePoint
                Pause-Pika
            }

            "3" {
                Restore-PikaBackup
            }

            "4" {
                Start-Process explorer.exe $script:BackupRoot
            }

            "0" {
                return
            }
        }
    }
}

# ============================================================
# REGISTRY HELPERS
# ============================================================

function Set-PikaRegistryValue {
    param(
        [string]$Path,
        [string]$Name,
        $Value,
        [ValidateSet("String","DWord","QWord","Binary")]
        [string]$Type = "DWord"
    )

    try {
        if (-not (Test-Path $Path)) {
            New-Item -Path $Path -Force | Out-Null
        }

        New-ItemProperty `
            -Path $Path `
            -Name $Name `
            -Value $Value `
            -PropertyType $Type `
            -Force | Out-Null

        Write-Log "Registry set: $Path\$Name = $Value"

        return $true
    }
    catch {
        Write-Log "Registry failed: $Path\$Name"
        return $false
    }
}

